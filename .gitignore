# Generated by xcodegen
*.xcodeproj

# Build products. The directory is dot-prefixed on purpose: Spotlight and
# Launchpad skip hidden directories, so the build product is not indexed as
# a second installed copy of the app.
build/
.build/
DerivedData/
.DS_Store

# Release artifacts produced by scripts/release.sh --build
dist/

# Xcode user state
xcuserdata/
*.xcuserstate
