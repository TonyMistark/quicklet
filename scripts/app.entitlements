<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The main app is intentionally NOT sandboxed: it executes the shell
	     commands handed over by the sandboxed Finder Sync extension. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.ice.quicklet</string>
	</array>
</dict>
</plist>
